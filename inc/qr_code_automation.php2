function show_admin_verification_page() {
    if (!current_user_can('manage_options')) {
        wp_die('Unauthorized access.');
    }
    
    $entry_id = sanitize_text_field($_GET['entry'] ?? '');
    $code = sanitize_text_field($_GET['code'] ?? '');
    $admin_key = sanitize_text_field($_GET['admin_key'] ?? '');
    
    // Handle verification action
    if ($_POST['action'] === 'verify_attendance' && wp_verify_nonce($_POST['nonce'], 'verify_' . $entry_id)) {
        $result = mark_attendance_verified($entry_id, $code);
        $message = $result ? 'Attendance verified successfully!' : 'Error verifying attendance.';
    }
    
    ?>
    <!DOCTYPE html>
    <html>
    <head>
        <title>Admin Verification - CPDAP</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <style>
            body { font-family: Arial, sans-serif; max-width: 800px; margin: 50px auto; padding: 20px; }
            .verify-btn { background: #0073aa; color: white; padding: 15px 30px; border: none; border-radius: 5px; font-size: 16px; cursor: pointer; }
            .verify-btn:hover { background: #005a87; }
            .info-box { background: #f0f0f1; padding: 20px; border-radius: 5px; margin: 20px 0; }
            .success { color: #0f5132; background: #d1e7dd; padding: 15px; border-radius: 5px; }
            .error { color: #842029; background: #f8d7da; padding: 15px; border-radius: 5px; }
        </style>
    </head>
    <body>
        <h1>🛡️ Admin Verification Panel</h1>
        
        <?php if (isset($message)): ?>
            <div class="<?php echo $result ? 'success' : 'error'; ?>">
                <?php echo esc_html($message); ?>
            </div>
        <?php endif; ?>
        
        <div class="info-box">
            <h3>Attendance Verification Request</h3>
            <p><strong>Entry ID:</strong> <?php echo esc_html($entry_id); ?></p>
            <p><strong>QR Code:</strong> <?php echo esc_html($code); ?></p>
            <p><strong>Status:</strong> <?php echo check_admin_verification($entry_id, $code) ? 'Already Verified ✅' : 'Pending Verification ⏳'; ?></p>
        </div>
        
        <?php if (!check_admin_verification($entry_id, $code)): ?>
            <form method="post">
                <input type="hidden" name="action" value="verify_attendance">
                <input type="hidden" name="nonce" value="<?php echo wp_create_nonce('verify_' . $entry_id); ?>">
                
                <h3>Verify Physical Attendance</h3>
                <p>Only click this button if the person is physically present at the event:</p>
                
                <button type="submit" class="verify-btn" onclick="return confirm('Confirm that this person is physically present at the event?')">
                    ✅ VERIFY ATTENDANCE
                </button>
            </form>
        <?php else: ?>
            <div class="success">
                <h3>✅ Already Verified</h3>
                <p>This attendance has already been verified by an administrator.</p>
            </div>
        <?php endif; ?>
        
        <hr>
        <p><small>CPDAP Admin Panel - Use this to verify physical attendance and prevent fraudulent certificate claims.</small></p>
    </body>
    </html>
    <?php
}

function check_admin_verification($entry_id, $code) {
    // Check WordPress options table for verification status
    $verification_key = 'cpdap_verified_' . $entry_id . '_' . md5($code);
    return get_option($verification_key, false);
}

function mark_attendance_verified($entry_id, $code) {
    // Store verification in WordPress options table
    $verification_key = 'cpdap_verified_' . $entry_id . '_' . md5($code);
    return update_option($verification_key, array(
        'verified_at' => current_time('mysql'),
        'verified_by' => get_current_user_id(),
        'entry_id' => $entry_id,
        'code' => $code
    ));
}

// Flush rewrite rules on activation (add this to your theme's functions.php)
add_action('after_switch_theme', 'flush_rewrite_rules');

