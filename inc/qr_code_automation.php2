// Handle admin approval/rejection actions
add_action('admin_init', 'handle_qr_approval_actions');

function handle_qr_approval_actions() {
    if (!current_user_can('manage_options')) {
        return;
    }
    
    $action = $_GET['action'] ?? '';
    $qr_id = intval($_GET['qr_id'] ?? 0);
    $entry_id = intval($_GET['entry_id'] ?? 0);
    $nonce = $_GET['nonce'] ?? '';
    
    if ($action === 'approve_qr' && $qr_id > 0) {
        if (wp_verify_nonce($nonce, 'approve_qr_' . $qr_id)) {
            approve_qr_code($qr_id, $entry_id);
            wp_redirect(admin_url('admin.php?page=sos-dynamic-qr-code-qrcodes&message=approved'));
            exit;
        }
    } elseif ($action === 'reject_qr' && $qr_id > 0) {
        if (wp_verify_nonce($nonce, 'reject_qr_' . $qr_id)) {
            reject_qr_code($qr_id, $entry_id);
            wp_redirect(admin_url('admin.php?page=sos-dynamic-qr-code-qrcodes&message=rejected'));
            exit;
        }
    }
}

function approve_qr_code($qr_id, $entry_id) {
    $plugin = SOSIDEE_DYNAMIC_QRCODE\SosPlugin::instance();
    
    // Load QR code data
    $qrcode = $plugin->database->loadQrCode($qr_id);
    if (!$qrcode) {
        return false;
    }
    
    // Enable the QR code
    $update_data = [
        'disabled' => false,
        'description' => str_replace('[PENDING APPROVAL] ', '[APPROVED] ', $qrcode->description)
    ];
    
    $result = $plugin->database->saveQrCode($update_data, $qr_id);
    
    if ($result !== false) {
        // Extract user details from description (basic approach)
        preg_match('/QR Code for (.+?) \(Entry #(\d+)\)/', $qrcode->description, $matches);
        $user_name = $matches[1] ?? 'User';
        
        // You might want to store user email in QR code data for better retrieval
        // For now, we'll skip sending approval email to user
        // send_approval_confirmation($user_email, $user_name, $qr_id, $entry_id, $qrcode->code);
        
        error_log("QR Code approved: ID {$qr_id} for entry {$entry_id}");
        return true;
    }
    
    return false;
}

function reject_qr_code($qr_id, $entry_id) {
    $plugin = SOSIDEE_DYNAMIC_QRCODE\SosPlugin::instance();
    
    // Delete/cancel the QR code
    $result = $plugin->database->deleteQrCode($qr_id);
    
    if ($result !== false) {
        error_log("QR Code rejected and deleted: ID {$qr_id} for entry {$entry_id}");
        return true;
    }
    
    return false;
}

// Create verification pages
add_action('init', 'create_qr_verification_pages');

function create_qr_verification_pages() {
    // Add rewrite rules for our custom verification pages
    add_rewrite_rule(
        '^qr-verify/?$',
        'index.php?qr_verify=1',
        'top'
    );
    
    add_rewrite_rule(
        '^qr-admin-verify/?$', 
        'index.php?qr_admin_verify=1',
        'top'
    );
    
    // Add query vars
    add_filter('query_vars', function($vars) {
        $vars[] = 'qr_verify';
        $vars[] = 'qr_admin_verify';
        return $vars;
    });
}

// Handle the verification pages
add_action('template_redirect', 'handle_qr_verification_pages');

function handle_qr_verification_pages() {
    global $wp_query;
    
    if (get_query_var('qr_verify')) {
        show_qr_verification_page();
        exit;
    }
    
    if (get_query_var('qr_admin_verify')) {
        show_admin_verification_page();
        exit;
    }
}

